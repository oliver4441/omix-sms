{
  "name": "omix-sms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --no-turbopack",
    "build": "npx prisma generate && npx prisma generate --schema=prisma/local-schema.prisma && NODE_OPTIONS='--max-old-space-size=1024' next build",
    "next-build": "NODE_OPTIONS='--max-old-space-size=1024' next build",
    "start": "npx prisma db push && next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.19.3",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^7.0.13",
    "otplib": "^13.4.0",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
